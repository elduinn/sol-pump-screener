# sol-pump-screener credentials — this project only.
# This bot's token must be its OWN: `npm start` runs --serve (alerts + listening
# for /cek, ⚖️ Cek buttons and prompts), and Telegram allows only one getUpdates
# consumer per token — a token shared with another listening bot gets 409s.

# ── Telegram ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_IDS=

# ── LLM (OpenAI-compatible endpoint) ──────────────────────────────────────
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# ── /cek verdict (all optional) ───────────────────────────────────────────
# Full OpenAI-compatible chat-completions URL (OpenRouter, DeepSeek, ...).
CEK_LLM_URL=https://api.deepseek.com/chat/completions
CEK_LLM_KEY=
CEK_LLM_MODEL=deepseek-v4-flash
# Solana RPC for the mint check (empty = public mainnet RPC).
# SOL_RPC_URL=
# Agent Meridian top-LP study + chart (empty = Meridian's public key).
# MERIDIAN_API_KEY=
# Jupiter quote API key (empty = free lite-api).
# JUPITER_API_KEY=
